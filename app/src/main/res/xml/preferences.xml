<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- API Key -->
    <PreferenceCategory
        app:title="Google Cloud"
        app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="api_key"
            app:title="API Key"
            app:dialogTitle="Enter Google Cloud API Key"
            app:dialogMessage="Get your free key at:\nconsole.cloud.google.com → APIs &amp; Services → Credentials"
            app:useSimpleSummaryProvider="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Voice settings -->
    <PreferenceCategory
        app:title="Voice"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="voice_name"
            app:title="Voice Quality"
            app:summary="South African English Female"
            app:entries="@array/voice_labels"
            app:entryValues="@array/voice_values"
            app:defaultValue="en-ZA-Standard-A"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="speaking_rate"
            app:title="Speaking Speed"
            app:entries="@array/speed_labels"
            app:entryValues="@array/speed_values"
            app:defaultValue="1.0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="pitch"
            app:title="Pitch"
            app:entries="@array/pitch_labels"
            app:entryValues="@array/pitch_values"
            app:defaultValue="0.0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Self-hosted TTS engine — Pocket TTS (:8007) -->
    <PreferenceCategory
        app:title="Self-Hosted Engine"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="chatterbox_host"
            app:title="Engine (Host:Port)"
            app:dialogTitle="Self-Hosted TTS Engine"
            app:entries="@array/tts_engine_labels"
            app:entryValues="@array/tts_engine_values"
            app:defaultValue="192.168.0.85:8007"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="chatterbox_voice"
            app:title="Reference Voice Name"
            app:dialogTitle="Reference Voice Name"
            app:dialogMessage="Name of the voice on the server (e.g. myvoice — no extension)"
            app:defaultValue="myvoice"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- About -->
    <PreferenceCategory
        app:title="About"
        app:iconSpaceReserved="false">

        <Preference
            app:key="about_voice"
            app:title="Voice: en-ZA-Neural2-A"
            app:summary="South African English Female — Neural2 (highest quality)"
            app:iconSpaceReserved="false"
            app:selectable="false" />

        <Preference
            app:key="about_free"
            app:title="Free Tier"
            app:summary="1 million characters/month free — approx. 10,000 WhatsApp messages"
            app:iconSpaceReserved="false"
            app:selectable="false" />

        <Preference
            app:key="about_version"
            app:title="VoiceNoteZA v1.0.0"
            app:summary="github.com/fdavids77/VoiceNoteZA"
            app:iconSpaceReserved="false"
            app:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
