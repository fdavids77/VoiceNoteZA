<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Expose the app's cache/voice_notes/ directory via FileProvider.
        Contains both .ogg (Google TTS) and .mp3 (ElevenLabs) output files.
    -->
    <cache-path
        name="voice_notes"
        path="voice_notes/" />
</paths>
