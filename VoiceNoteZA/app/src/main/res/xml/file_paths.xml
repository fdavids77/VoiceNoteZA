<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Expose the app's cache/voice_notes/ directory to WhatsApp via FileProvider.
        This is where GoogleTtsClient saves the generated OGG file.
    -->
    <cache-path
        name="voice_notes"
        path="voice_notes/" />
</paths>
